#!/usr/bin/env zsh
set -euo pipefail

DEVELOPER_ROOT="${DEVELOPER_ROOT:-/Users/openfrontierlabs/Developer}"
source "$DEVELOPER_ROOT/env.sh" 2>/dev/null || true

READER_DIR="$DEVELOPER_ROOT/opt/flipbook-reader"
APP_BUNDLE="$DEVELOPER_ROOT/apps/FlipBook Reader.app"
DATA_DIR="$DEVELOPER_ROOT/data/flipbook-reader"
SERVER_JSON="$DATA_DIR/server.json"

WEB_MODE=0
PORT=0
PAGE=""
FILE_ARG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --web|-w)
      WEB_MODE=1
      shift
      ;;
    --port|-P)
      PORT="${2:-0}"
      shift 2
      ;;
    --page|-p)
      PAGE="${2:-}"
      shift 2
      ;;
    --help|-h)
      cat << 'USAGE'
Usage: flipbook [file.pdf[#p=N]] [--page N] [--web] [--port PORT]

Options:
  --page, -p N     Open at page N
  --web,  -w       Open in Google Chrome / default browser instead of native FlipBook Reader.app
  --port, -P PORT  Listen on specific localhost port (with --web)
  --help, -h       Show this help
USAGE
      exit 0
      ;;
    *)
      if [[ -z "$FILE_ARG" ]]; then
        FILE_ARG="$1"
      fi
      shift
      ;;
  esac
done

# Support file.pdf#p=50 syntax
if [[ -n "$FILE_ARG" && "$FILE_ARG" == *"#p="* ]]; then
  if [[ -z "$PAGE" ]]; then
    PAGE="${FILE_ARG#*#p=}"
    PAGE="${PAGE%%[^0-9]*}"
  fi
  FILE_ARG="${FILE_ARG%%#p=*}"
fi

ABS_FILE=""
if [[ -n "$FILE_ARG" ]]; then
  if [[ ! -f "$FILE_ARG" ]]; then
    echo "Error: PDF file not found: $FILE_ARG" >&2
    exit 1
  fi
  ABS_FILE="$(cd "$(dirname "$FILE_ARG")" && pwd)/$(basename "$FILE_ARG")"
  if [[ -n "$PAGE" ]]; then
    node "$READER_DIR/server.mjs" --register "$ABS_FILE" --page "$PAGE" >/dev/null
  else
    node "$READER_DIR/server.mjs" --register "$ABS_FILE" >/dev/null
  fi
fi

if [[ "$WEB_MODE" -eq 0 && -d "$APP_BUNDLE" ]]; then
  if [[ -n "$ABS_FILE" ]]; then
    open -a "$APP_BUNDLE" "$ABS_FILE"
  else
    open -a "$APP_BUNDLE"
  fi
  exit 0
fi

# Web fallback / --web mode: reuse running server if alive, else spawn detached
TARGET_PORT=""
if [[ -f "$SERVER_JSON" ]]; then
  EXISTING_PORT="$(python3 -c "import json,sys; d=json.load(open('$SERVER_JSON')); print(d.get('port',''))" 2>/dev/null || true)"
  if [[ -n "$EXISTING_PORT" ]] && curl -sf "http://127.0.0.1:${EXISTING_PORT}/api/health" >/dev/null 2>&1; then
    TARGET_PORT="$EXISTING_PORT"
  fi
fi

if [[ -z "$TARGET_PORT" ]]; then
  LOG_FILE="$DATA_DIR/server.log"
  ARGS=(--port "$PORT")
  if [[ -n "$ABS_FILE" ]]; then
    ARGS+=("$ABS_FILE")
    [[ -n "$PAGE" ]] && ARGS+=(--page "$PAGE")
  fi
  nohup node "$READER_DIR/server.mjs" "${ARGS[@]}" >"$LOG_FILE" 2>&1 </dev/null &
  for _ in {1..40}; do
    if [[ -f "$SERVER_JSON" ]]; then
      CANDIDATE="$(python3 -c "import json; print(json.load(open('$SERVER_JSON')).get('port',''))" 2>/dev/null || true)"
      if [[ -n "$CANDIDATE" ]] && curl -sf "http://127.0.0.1:${CANDIDATE}/api/health" >/dev/null 2>&1; then
        TARGET_PORT="$CANDIDATE"
        break
      fi
    fi
    sleep 0.1
  done
fi

if [[ -z "$TARGET_PORT" ]]; then
  echo "Error: Failed to start FlipBook server. Check $DATA_DIR/server.log" >&2
  exit 1
fi

URL="http://127.0.0.1:${TARGET_PORT}/"
if [[ -n "$ABS_FILE" ]]; then
  RESP="$(curl -sf -X POST "http://127.0.0.1:${TARGET_PORT}/api/open" \
    -H "Content-Type: application/json" \
    -d "$(python3 -c "import json,sys; print(json.dumps({'path': sys.argv[1], 'page': int(sys.argv[2]) if sys.argv[2] else None}))" "$ABS_FILE" "$PAGE")")"
  BOOK_ID="$(python3 -c "import json,sys; print(json.loads(sys.stdin.read()).get('id',''))" <<<"$RESP")"
  if [[ -n "$BOOK_ID" ]]; then
    URL="http://127.0.0.1:${TARGET_PORT}/?book=${BOOK_ID}"
    [[ -n "$PAGE" ]] && URL="${URL}#p=${PAGE}"
  fi
fi

open "$URL"
